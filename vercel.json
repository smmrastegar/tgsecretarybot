    {
      "path": "/api/cron/mirror-albums",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/auto-summary",
      "schedule": "*/5 * * * *"
