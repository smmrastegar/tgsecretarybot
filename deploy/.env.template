# --- tgsecretarybot self-hosted env ---
# Copy the real values from your Vercel project's Environment Variables
# (Settings → Environment Variables → reveal). Fill every blank, then
# save this file as  /opt/tgsecretarybot/.env  (chmod 600).

# ── Core (required) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=

# DATABASE: now LOCAL to this box. Point at 127.0.0.1 and disable SSL
# (loopback needs none). Keep the same db name / user / password as the
# current remote URL — only the host changes from 209.97.138.127 → 127.0.0.1.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/tgsecretarybot?sslmode=disable

# ── Secrets (copy from Vercel) ───────────────────────────────────
WEBHOOK_SECRET_TOKEN=
SESSION_SECRET=
SETUP_SECRET=
CRON_SECRET=
MCP_SECRET=

# ── Public URL / identity ────────────────────────────────────────
# The HTTPS domain that will point at THIS server (set up DNS first).
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN
NEXT_PUBLIC_BOT_USERNAME=

# ── Optional integrations (copy whatever you use) ────────────────
GROQ_API_KEY=
HIKER_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_INBOUND_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPENROUTER_MODEL=
OPENROUTER_APP_NAME=
OPENROUTER_APP_URL=
SMS_WEBHOOK_SECRET=

# Local app port (Caddy proxies 443 → this). Leave as-is unless taken.
PORT=3000
NODE_ENV=production
