[Unit]
Description=Run tgsecretarybot auto-deploy every 30s

[Timer]
# 20s after boot, then every 30s. Persistent catches up a missed
# tick after downtime. The service itself no-ops when HEAD is unchanged,
# so a tight cadence just means faster pickup of a fresh commit.
OnBootSec=20
OnUnitActiveSec=30
Persistent=true

[Install]
WantedBy=timers.target
