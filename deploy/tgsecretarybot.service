[Unit]
Description=tgsecretarybot (Next.js) — Telegram secretary bot + dashboard
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/tgsecretarybot
EnvironmentFile=/opt/tgsecretarybot/.env
# `npm start` → `next start -p $PORT`. The build must already exist
# (deploy.sh runs `next build`). Restart on crash, cap restart storms.
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5
# Keep logs in journald: `journalctl -u tgsecretarybot -f`
StandardOutput=journal
StandardError=journal
# Light hardening
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
