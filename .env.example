# ===== Required ============================================================
# Telegram bot (BotFather: /newbot, /mybots → Bot Settings → Business Mode on)
TELEGRAM_BOT_TOKEN=
# OpenRouter key for the classifier and group summarizer
OPENROUTER_API_KEY=
# Neon connection string (or any Postgres). Without it the dashboard does not work.
DATABASE_URL=
# Secret guarding /api/setup (must match the one you call the endpoint with)
SETUP_SECRET=
# Secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET_TOKEN=
# Voice transcription: by default uses your OpenRouter key with Gemini 2.5
# Flash (the same model already pays for classify/summary calls). If you'd
# rather use Groq's whisper-large-v3-turbo (free tier, faster, OGG-native),
# put a Groq API key here. The bot tries OpenRouter first and falls back to
# Groq automatically. Get a Groq key at https://console.groq.com.
GROQ_API_KEY=
# Optional Upstash Redis for faster settings/autoreply cache across cold
# starts. Sign up at https://console.upstash.com (free tier is generous).
# Without these, in-memory cache is used as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Session / auth =====================================================
# Used to sign the dashboard session cookie. Defaults to WEBHOOK_SECRET_TOKEN.
SESSION_SECRET=
# Bot username for the Telegram Login Widget (without @). Defaults to smmrchatbot.
NEXT_PUBLIC_BOT_USERNAME=smmrchatbot
# Auto-injected by Vercel; set manually in local dev if you want absolute URLs.
NEXT_PUBLIC_APP_URL=

# ===== Tunables (these are editable from the Settings UI) ==================
# Setting any of these in env locks the corresponding field in the UI.
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_APP_NAME=tgsecretarybot
OPENROUTER_APP_URL=
OWNER_NAME=
OWNER_CONTEXT=
IMPORTANCE_THRESHOLD=7
OWNER_NOTIFY_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_METHOD=POST
ALERT_WEBHOOK_HEADERS={}
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=در حال حاضر قادر به پاسخ‌گویی نیستم. به محض اینکه بتوانم پاسخ می‌دهم.
AUTO_REPLY_COOLDOWN_MINUTES=60
GROUP_ANALYSIS_ENABLED=true
GROUP_SUMMARY_HOUR_UTC=3

# ===== Cron ===============================================================
# Auto-injected by Vercel Cron; set it to any random string in local dev to
# unlock POST /api/cron/daily-summary. Leave empty to allow without auth.
CRON_SECRET=
