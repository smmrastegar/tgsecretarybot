# ---- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then enable "Business Mode" for it:
#   /mybots -> <your bot> -> Bot Settings -> Business Mode -> Turn on
# The owner connects this bot from Settings -> Telegram Business -> Chatbots.
TELEGRAM_BOT_TOKEN=

# ---- OpenRouter (classifier) ------------------------------------------------
OPENROUTER_API_KEY=
# A cheap model is fine; classification is short. Examples:
#   google/gemini-2.0-flash-lite-001
#   anthropic/claude-haiku-4-5
#   openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# Optional: shown to OpenRouter on the leaderboard.
OPENROUTER_APP_NAME=tgsecretarybot
OPENROUTER_APP_URL=

# ---- Alert device webhook ---------------------------------------------------
# Where to POST when an urgent message is detected. Leave empty to disable
# (the bot will still classify and log, but not call out).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_METHOD=POST
# Extra headers as a JSON object string, e.g. {"X-Auth":"secret"}
ALERT_WEBHOOK_HEADERS={}

# ---- Owner profile (helps the classifier) -----------------------------------
# Your name as people address you in chats.
OWNER_NAME=
# Free-text context about you (role, family, projects). One line.
OWNER_CONTEXT=

# ---- Tuning -----------------------------------------------------------------
# Minimum importance (0-10) to fire an alert. The classifier also must mark
# the message as urgent AND concerning the owner.
IMPORTANCE_THRESHOLD=7
# Optional: chat id to also receive a Telegram heads-up (usually your own
# user id). Leave empty to disable.
OWNER_NOTIFY_CHAT_ID=

# ---- Vercel webhook deployment ---------------------------------------------
# Random string (1-256 chars, [A-Za-z0-9_-]) that Telegram echoes back in
# X-Telegram-Bot-Api-Secret-Token. Set the same value here and pass it to
# setWebhook (the /api/setup endpoint does this automatically).
WEBHOOK_SECRET_TOKEN=
# Random secret guarding the /api/setup endpoint. Hit
#   https://<your-deployment>.vercel.app/api/setup?secret=<SETUP_SECRET>
# once after deploying to register the webhook with Telegram.
# Also supports ?action=info | delete and ?drop=1.
SETUP_SECRET=

# ---- Auto-reply (sent AS the owner via business connection) ----------------
# When the classifier marks a private DM as urgent (and the same alert gate
# fires), the bot replies to the sender on the owner's behalf. The bot needs
# the can_reply right in Telegram Business -> Chatbots for this to work.
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=در حال حاضر قادر به پاسخ‌گویی نیستم. به محض اینکه بتوانم پاسخ می‌دهم.
# Don't send another auto-reply to the same chat within this many minutes.
AUTO_REPLY_COOLDOWN_MINUTES=60

# ---- Neon Postgres (urgent message log) ------------------------------------
# Neon connection string (pooler URL recommended for serverless). Leave empty
# to disable DB logging. The bot auto-creates the urgent_messages table on
# first insert.
DATABASE_URL=
